<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pinky_wall_parking_maneuver</name>
  <version>0.0.0</version>
  <description>Car-like parking maneuvers (Reeds-Shepp, T parking)</description>
  <maintainer email="52153542+solidSnakesado@users.noreply.github.com">sado</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pinky_wall_parking_sim</exec_depend>
  <exec_depend>pinky_wall_parking_perception</exec_depend>
  <exec_depend>pinky_wall_parking_docking</exec_depend>
  <exec_depend>pinky_wall_parking_dock_plugin</exec_depend>
  <exec_depend>opennav_docking</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <!-- rsplan (Reeds-Shepp) 은 rosdep 키가 없는 pip 패키지: pip install rsplan -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

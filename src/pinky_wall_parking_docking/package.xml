  <version>0.0.0</version>
  <description>Wall slot parking with the Nav2 docking server</description>
  <maintainer email="52153542+solidSnakesado@users.noreply.github.com">solidSnakesado</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>opennav_docking</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_msgs</depend>
